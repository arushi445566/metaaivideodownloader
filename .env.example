# Copy these into your host's Environment Variables (e.g. Render → Environment).
# All are optional — the app runs without them, but these unlock key features.

# Brand name shown across the site (defaults to "MetaVidSaver").
SITE_NAME=MetaVidSaver

# Google AdSense publisher ID. When set, the AdSense auto-ads loader is injected
# and /ads.txt serves your publisher line. Example: ca-pub-1234567890123456
ADSENSE_CLIENT=

# Residential/HTTP proxy to bypass datacenter-IP blocks on Instagram/Facebook/Meta
# when deployed on a cloud host. Routes BOTH yt-dlp and the Meta AI extractor.
# Format: http://user:pass@host:port   (or http://host:port)
PROXY=

# Full contents of a Netscape-format cookies.txt (exported while logged in).
# Used to authenticate Instagram/Facebook requests. Keep this secret.
COOKIES_CONTENT=
